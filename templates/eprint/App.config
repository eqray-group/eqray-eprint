<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- 首次启动的默认服务端地址：登录页修改后会写入 %LOCALAPPDATA%\yiyunyin\client.json，下次启动直接生效 -->
        <add key="ApiBaseUrl" value="http://127.0.0.1:11111" />
        <!-- SumatraPDF 便携版路径：留空使用 tools\SumatraPDF.exe，相对路径基于程序目录 -->
        <add key="SumatraPdfPath" value="" />
    </appSettings>
</configuration>
